# Valid baseline rules
RULE ssh_attack IF src_ip == 10.0.0.5 AND port == 22 AND attempts > 5 THEN ALERT "SSH brute force";
RULE suspicious_dns IF domain == "example.invalid" AND queries >= 50 THEN ALERT "Possible DNS tunnelling";
RULE malware_hash IF sha256 == a3f5c7d9e1b3a5c7d9e1b3a5c7d9e1b3a5c7d9e1b3a5c7d9e1b3a5c7d9e1b3 THEN ALERT "Known malware hash";
